{
  "manifest_version": 3,
  "name": "iChess",
  "version": "2",
  "key": "17f06cae4d6be44be69130c560ae714f",
  "description": "Chess - live Coach",
  "icons": {
    "16": "icons/1.png",
    "48": "icons/2.png",
    "128": "icons/3.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/1.png",
      "48": "icons/2.png",
      "128": "icons/3.png"
    }
  },
  "permissions": [
    "activeTab",
    "debugger",
    "windows",
    "offscreen",
    "tabs",
    "webNavigation",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "https://*.chess.com/*",
    "https://api.timezonedb.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://lichess.org/*",
    "https://worldchess.com/*",
    "https://fonts.googleapis.com/*",
    "https://text-and-audio.chess.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/main.js",
        "engine/chess_min.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.chess.com/*",
        "*://*.lichess.org/*",
        "*://*.worldchess.com/*"
      ],
      "js": [
        "scripts/core.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/sub-main.js",
        "engine/chess_min.js",
        "engine/komodo.js",
        "engine/komodo.wasm",
        "engine/torch.js",
        "engine/torch.wasm",
        "overlay/index.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
